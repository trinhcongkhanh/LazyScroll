
<Window
    x:Class="LazyScroll.App.Views.ModeMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LazyScroll Mode"
    Width="290"
    Height="240"
    ResizeMode="NoResize"
    WindowStyle="ToolWindow"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    Topmost="True"
    KeyDown="Window_KeyDown">

    <Border Padding="16">

        <StackPanel>

            <TextBlock
                Text="LazyScroll"
                FontSize="20"
                FontWeight="Bold"
                Margin="0,0,0,8"/>

            <TextBlock
                Text="Select scrolling mode"
                Margin="0,0,0,12"/>

            <Button
                Content="Normal Scroll"
                Height="35"
                Margin="0,0,0,8"
                Click="Normal_Click"/>

            <Button
                Content="Timer Scroll"
                Height="35"
                Margin="0,0,0,8"
                Click="Timer_Click"/>

            <Button
                Content="Stop Timer"
                Height="35"
                Click="Stop_Click"/>

        </StackPanel>

    </Border>
</Window>
